{
  "name": "kmodels",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vue-tsc --noEmit && vp build",
    "catalog-repair:check": "node scripts/catalog-repair.ts",
    "catalog:audit": "node --env-file-if-exists=.env scripts/audit-catalog.ts",
    "catalog:audit:eval": "node --env-file-if-exists=.env scripts/evaluate-jev.ts",
    "check": "vp check",
    "collect": "node --env-file-if-exists=.env scripts/collect.ts",
    "collect:fixtures": "vp test --run tests/adapters.test.ts tests/sagemaker.test.ts tests/sagemaker-sdk.test.ts tests/typesafe.test.ts",
    "compile:pricing": "node scripts/compile-pricing.ts",
    "prepare:assets": "node scripts/prepare-assets.ts",
    "deploy": "void deploy --dir dist --skip-build",
    "preview": "vp preview",
    "report:refresh": "node scripts/report-refresh.ts",
    "test": "vp test --run",
    "test:data": "vp test --run --project generated"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock": "^3.1136.0",
    "@aws-sdk/client-sagemaker": "^3.1136.0",
    "@lobehub/icons-static-svg": "1.95.0",
    "@renovatebot/pep440": "^5.0.1",
    "cheerio": "^1.2.0",
    "jsonc-parser": "3.3.1",
    "lucide-static": "1.47.0",
    "overlayscrollbars": "2.16.0",
    "vue": "3.6.0-rc.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "typescript": "~6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.3",
    "vite-plus": "0.3.3",
    "void": "^0.20.1",
    "vue-tsc": "^3.3.11"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.27.0",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@11.27.0"
}
