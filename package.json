{
  "name": "kmodels",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vue-tsc --noEmit && vp build && node scripts/check-price-assets.ts",
    "check": "vp check",
    "collect": "node --env-file-if-exists=.env scripts/collect.ts",
    "compile:pricing": "node scripts/compile-pricing.ts",
    "prepare:assets": "node scripts/prepare-assets.ts",
    "package:build": "vp pack && node scripts/pricing-package-schema.ts && vp fmt packages/pricing/schema.json packages/pricing/query.schema.json",
    "package:check": "node --experimental-vm-modules scripts/check-pricing-package.ts",
    "self-heal:triage": "node scripts/self-heal/triage.ts",
    "self-heal:gate": "node scripts/self-heal/gate.ts",
    "self-heal:generate": "node scripts/self-heal/generate.ts",
    "self-heal:verify": "node scripts/self-heal/verify.ts",
    "self-heal:publish": "node scripts/self-heal/publish.ts",
    "self-heal:budget": "node scripts/self-heal/budget.ts",
    "deploy": "void deploy --dir dist --skip-build",
    "preview": "vp preview",
    "report:refresh": "node scripts/report-refresh.ts",
    "test": "vp test --run",
    "test:data": "vp test --run --project generated",
    "test:e2e": "node scripts/check-website-e2e.ts",
    "test:pricing-performance": "node scripts/check-pricing-performance.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock": "^3.1168.0",
    "@aws-sdk/client-sagemaker": "^3.1168.0",
    "@lobehub/icons-static-svg": "1.102.0",
    "@renovatebot/pep440": "^5.0.1",
    "@smithy/core": "3.40.0",
    "cheerio": "^1.2.0",
    "jsonc-parser": "3.3.1",
    "lucide-static": "1.72.0",
    "overlayscrollbars": "2.17.0",
    "vue": "3.6.0-rc.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "node-gyp": "^13.1.0",
    "playwright": "1.65.0",
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.19.tsgo.7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vite-plus": "1.6.0",
    "void": "^0.28.0",
    "vue-tsc": "^3.3.14"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.20.0",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@12.20.0"
}
