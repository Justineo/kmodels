{
  "name": "kmodels",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vue-tsc --noEmit && vp build",
    "check": "vp check",
    "collect": "node --env-file-if-exists=.env scripts/collect.ts",
    "collect:fixtures": "vp test --run tests/adapters.test.ts",
    "compile:pricing": "node scripts/compile-pricing.ts",
    "prepare:assets": "node scripts/prepare-assets.ts",
    "deploy": "void deploy --dir dist --skip-build",
    "preview": "vp preview",
    "report:refresh": "node scripts/report-refresh.ts",
    "test": "vp test --run",
    "test:data": "vp test --run --project generated"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock": "^3.1106.0",
    "@lobehub/icons-static-svg": "1.94.0",
    "cheerio": "^1.2.0",
    "jsonc-parser": "3.3.1",
    "lucide-static": "1.30.0",
    "overlayscrollbars": "2.16.0",
    "vue": "3.6.0-rc.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "~6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.8",
    "vite-plus": "0.2.8",
    "void": "^0.10.11",
    "vue-tsc": "^3.3.9"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@11.20.0"
}
