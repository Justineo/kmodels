{
  "servers": [{ "url": "https://api.moonshot.ai" }],
  "paths": {
    "/v1/models": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "object": { "type": "string", "example": "list" },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string" },
                          "object": { "type": "string", "example": "model" },
                          "created": { "type": "integer" },
                          "owned_by": { "type": "string" },
                          "context_length": { "type": "integer" },
                          "supports_image_in": { "type": "boolean" },
                          "supports_video_in": { "type": "boolean" },
                          "supports_reasoning": { "type": "boolean" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/chat/completions": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "discriminator": {
                  "propertyName": "model",
                  "mapping": {
                    "kimi-k3": "#/components/schemas/K3",
                    "kimi-k2.7-code": "#/components/schemas/K27",
                    "kimi-k2.7-code-highspeed": "#/components/schemas/K27",
                    "kimi-k2.6": "#/components/schemas/K26"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ChatCompletionResponse" }
              },
              "text/event-stream": {
                "schema": { "$ref": "#/components/schemas/ChatCompletionChunk" }
              }
            }
          }
        }
      }
    },
    "/v1/responses": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ResponsesRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ResponsesResponse" }
              },
              "text/event-stream": {
                "schema": { "$ref": "#/components/schemas/ResponsesStreamEvent" }
              }
            }
          }
        }
      }
    },
    "/anthropic/v1/messages": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MessagesRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessagesResponse" }
              },
              "text/event-stream": {
                "schema": { "$ref": "#/components/schemas/MessagesStreamEvent" }
              }
            }
          }
        }
      }
    },
    "/v1/tokenizers/estimate-token-count": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/EstimateRequest" }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EstimateRequest": {
        "properties": {
          "model": {
            "enum": ["kimi-k3", "kimi-k2.7-code", "kimi-k2.7-code-highspeed", "kimi-k2.6"]
          }
        }
      },
      "ToolDefinition": {
        "properties": {
          "type": { "enum": ["function"] }
        }
      },
      "Common": {
        "properties": {
          "response_format": {
            "properties": {
              "type": { "enum": ["text", "json_object", "json_schema"] }
            }
          },
          "stream": { "type": "boolean" },
          "stream_options": {
            "properties": {
              "include_usage": {
                "type": "boolean",
                "default": false,
                "description": "Shows token usage statistics for the entire request; if the stream is interrupted, the final usage chunk may not arrive."
              }
            }
          },
          "tools": {
            "items": { "$ref": "#/components/schemas/ToolDefinition" }
          },
          "tool_choice": {},
          "prompt_cache_key": { "type": "string" },
          "max_completion_tokens": {
            "type": "integer",
            "description": "The maximum number of tokens to generate for the chat completion. The default varies by model: for Kimi K3 it defaults to 131072 and can be set up to 1048576."
          }
        }
      },
      "ChatCompletionResponse": {
        "properties": {
          "usage": {
            "properties": {
              "prompt_tokens": { "type": "integer" },
              "completion_tokens": { "type": "integer" },
              "total_tokens": { "type": "integer" },
              "cached_tokens": { "type": "integer" }
            }
          }
        }
      },
      "ChatCompletionChunk": {
        "properties": {
          "usage": {
            "properties": {
              "prompt_tokens": { "type": "integer" },
              "completion_tokens": { "type": "integer" },
              "total_tokens": { "type": "integer" },
              "cached_tokens": { "type": "integer" }
            }
          }
        }
      },
      "ResponsesRequest": {
        "properties": {
          "model": {
            "type": "string",
            "description": "ID of the model to use. This endpoint currently supports `kimi-k3`.",
            "example": "kimi-k3"
          }
        }
      },
      "ResponsesUsage": {
        "type": "object",
        "properties": {
          "input_tokens": {
            "type": "integer",
            "description": "Number of input tokens, including cached tokens."
          },
          "input_tokens_details": {
            "type": "object",
            "properties": {
              "cached_tokens": {
                "type": "integer",
                "description": "Number of tokens served from the context cache."
              },
              "cache_write_tokens": {
                "type": "integer",
                "description": "Number of tokens written to the context cache."
              }
            }
          },
          "output_tokens": {
            "type": "integer",
            "description": "Number of output tokens, including reasoning tokens."
          },
          "output_tokens_details": {
            "type": "object",
            "properties": {
              "reasoning_tokens": {
                "type": "integer",
                "description": "Number of tokens spent on reasoning."
              }
            }
          },
          "total_tokens": { "type": "integer" }
        }
      },
      "ResponsesResponse": {
        "type": "object",
        "properties": {
          "usage": {
            "oneOf": [{ "$ref": "#/components/schemas/ResponsesUsage" }, { "type": "null" }]
          }
        }
      },
      "ResponsesStreamEvent": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["response.completed", "response.incomplete", "response.failed"]
          },
          "sequence_number": { "type": "integer" }
        }
      },
      "MessagesRequest": {
        "type": "object",
        "properties": {
          "model": { "type": "string", "enum": ["kimi-k3"], "default": "kimi-k3" }
        }
      },
      "MessagesResponse": {
        "type": "object",
        "properties": {
          "usage": {
            "type": "object",
            "properties": {
              "input_tokens": {
                "type": "integer",
                "description": "Input tokens (excluding cache hits)"
              },
              "output_tokens": {
                "type": "integer",
                "description": "Output tokens (including reasoning tokens)"
              },
              "cache_read_input_tokens": {
                "type": "integer",
                "description": "Input tokens served from cache"
              },
              "cache_creation_input_tokens": {
                "type": "integer",
                "description": "Input tokens written to cache"
              }
            }
          }
        }
      },
      "MessagesStreamEvent": {
        "oneOf": [
          {
            "title": "message_delta",
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["message_delta"] },
              "delta": { "type": "object" },
              "usage": {
                "type": "object",
                "properties": {
                  "input_tokens": {
                    "type": "integer",
                    "description": "Input tokens (excluding cache hits)"
                  },
                  "output_tokens": {
                    "type": "integer",
                    "description": "Output tokens (including reasoning tokens)"
                  },
                  "cache_read_input_tokens": {
                    "type": "integer",
                    "description": "Input tokens served from cache"
                  },
                  "cache_creation_input_tokens": {
                    "type": "integer",
                    "description": "Input tokens written to cache"
                  }
                }
              }
            }
          },
          {
            "title": "message_stop",
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["message_stop"] }
            }
          }
        ]
      },
      "K3": {
        "allOf": [
          { "$ref": "#/components/schemas/Common" },
          {
            "properties": {
              "model": { "enum": ["kimi-k3"] },
              "reasoning_effort": { "enum": ["low", "high", "max"] }
            }
          }
        ]
      },
      "K27": {
        "allOf": [
          { "$ref": "#/components/schemas/Common" },
          {
            "properties": {
              "model": { "enum": ["kimi-k2.7-code", "kimi-k2.7-code-highspeed"] },
              "thinking": {
                "properties": {
                  "type": { "enum": ["enabled"] }
                }
              }
            }
          }
        ]
      },
      "K26": {
        "allOf": [
          { "$ref": "#/components/schemas/Common" },
          {
            "properties": {
              "model": { "enum": ["kimi-k2.6"] },
              "thinking": {
                "properties": {
                  "type": { "enum": ["enabled", "disabled"] }
                }
              }
            }
          }
        ]
      },
      "K25": {
        "allOf": [
          { "$ref": "#/components/schemas/Common" },
          {
            "properties": {
              "model": { "enum": ["kimi-k2.5"] },
              "thinking": {
                "properties": {
                  "type": { "enum": ["enabled", "disabled"] }
                }
              }
            }
          }
        ]
      },
      "V1": {
        "allOf": [
          { "$ref": "#/components/schemas/Common" },
          {
            "properties": {
              "model": {
                "enum": [
                  "moonshot-v1-8k",
                  "moonshot-v1-32k",
                  "moonshot-v1-128k",
                  "moonshot-v1-auto",
                  "moonshot-v1-8k-vision-preview",
                  "moonshot-v1-32k-vision-preview",
                  "moonshot-v1-128k-vision-preview"
                ]
              }
            }
          }
        ]
      }
    }
  }
}
